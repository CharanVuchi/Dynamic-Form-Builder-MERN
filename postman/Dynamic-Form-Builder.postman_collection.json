              "raw": "{\n  \"name\": \"Customer Registration\",\n  \"description\": \"Register customer details\",\n  \"showName\": true,\n  \"showDescription\": true,\n  \"status\": \"Draft\",\n  \"fields\": [\n    {\n      \"id\": \"field-1\",\n      \"type\": \"text\",\n      \"label\": \"Full Name\",\n      \"fieldKey\": \"fullName\",\n      \"placeholder\": \"Enter your name\",\n      \"defaultValue\": \"\",\n      \"required\": true,\n      \"validation\": {}\n    },\n    {\n      \"id\": \"field-2\",\n      \"type\": \"email\",\n      \"label\": \"Email\",\n      \"fieldKey\": \"email\",\n      \"placeholder\": \"Enter email\",\n      \"defaultValue\": \"\",\n      \"required\": true,\n      \"validation\": {}\n    },\n    {\n      \"id\": \"field-3\",\n      \"type\": \"select\",\n      \"label\": \"Department\",\n      \"fieldKey\": \"department\",\n      \"required\": false,\n      \"options\": [\n        {\n          \"label\": \"Engineering\",\n          \"value\": \"engineering\"\n        },\n        {\n          \"label\": \"Sales\",\n          \"value\": \"sales\"\n        }\n      ],\n      \"validation\": {}\n    }\n  ]\n}",
